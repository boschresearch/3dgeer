+                    now = time.time()
+                    carry += (now - last) * fps_value
+                    last = now
+                    step = int(carry)
+                    if step > 0:
+                        carry -= float(step)
+                        export_playback_frame["value"] = (
+                            export_playback_frame["value"] + step
+                        ) % max_frame
+                        attach_preview_frame_sync()
