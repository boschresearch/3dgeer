+        unique_img_idx = getattr(camera, "unique_img_idx", None)
+        normalized_time = getattr(camera, "normalized_time", None)
+        num_frames = int(getattr(camera, "num_frames", 1))
+        idx = int(max(0, min(frame_idx, num_frames - 1)))
