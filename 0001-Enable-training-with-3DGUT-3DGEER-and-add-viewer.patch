+def _distort_pinhole(xy, radial_coeffs=None, tangential_coeffs=None):
+    """OpenCV rational radial model plus tangential distortion (normalized plane)."""
+    k = (
+        xy.new_zeros(6)
+        if radial_coeffs is None
+        else torch.as_tensor(radial_coeffs, device=xy.device, dtype=xy.dtype)
+    )
+    p = (
+        xy.new_zeros(2)
+        if tangential_coeffs is None
+        else torch.as_tensor(tangential_coeffs, device=xy.device, dtype=xy.dtype)
+    )
+    if k.shape != (6,) or p.shape != (2,):
+        raise ValueError('Pinhole distortion requires six radial and two tangential coefficients')
+    x, y = xy.unbind(-1)
+    r2 = x * x + y * y
+    numerator = 1 + r2 * (k[0] + r2 * (k[1] + r2 * k[2]))
+    denominator = 1 + r2 * (k[3] + r2 * (k[4] + r2 * k[5]))
+    radial = numerator / denominator
+    delta = torch.stack(
+        (2 * p[0] * x * y + p[1] * (r2 + 2 * x * x), p[0] * (r2 + 2 * y * y) + 2 * p[1] * x * y), -1
+    )
+    return xy * radial[..., None] + delta, radial, delta
+
+
+def project_camera_model(
+    points,
+    intrinsics,
+    camera_model='pinhole',
+    radial_coeffs=None,
+    ftheta_parameters=None,
+    tangential_coeffs=None,
+):
+    """Project camera-space points to pixel-center coordinates, with validity."""
+    r = torch.linalg.vector_norm(points[..., :2], dim=-1)
+    theta = torch.atan2(r, points[..., 2])
+    valid = torch.isfinite(points).all(-1) & (points.norm(dim=-1) > 1e-8)
+    if camera_model == 'pinhole':
+        xy = points[..., :2] / points[..., 2:].clamp_min(1e-8)
+        if radial_coeffs is not None or tangential_coeffs is not None:
+            xy, _, _ = _distort_pinhole(xy, radial_coeffs, tangential_coeffs)
+        pixels = xy * intrinsics.diagonal()[:2] + intrinsics[:2, 2]
+        return pixels, valid & (points[..., 2] > 0) & torch.isfinite(pixels).all(-1)
+    if camera_model == 'fisheye':
+        coefficients = [0.0, 1.0]
+        for k in (radial_coeffs if radial_coeffs is not None else [0.0] * 4):
+            coefficients.extend([0.0, float(k)])
+        radius = _camera_polynomial(coefficients, theta)
+        xy = points[..., :2] * (radius / r.clamp_min(1e-8))[..., None]
+        pixels = xy * intrinsics.diagonal()[:2] + intrinsics[:2, 2]
+        return pixels, valid & (theta < np.pi / 2)
+    if camera_model != 'ftheta' or ftheta_parameters is None:
+        raise ValueError('Expected pinhole, fisheye, or ftheta with calibration')
+    p = ftheta_parameters
+    radius = _camera_polynomial(p['angle_to_pixeldist_poly'], theta)
+    if p['reference_poly'] == 'PIXELDIST_TO_ANGLE':
+        radius, converged = _invert_camera_polynomial(p['pixeldist_to_angle_poly'], theta, radius)
+        valid &= converged
+    elif p['reference_poly'] != 'ANGLE_TO_PIXELDIST':
+        raise ValueError('Unknown FTheta reference polynomial')
+    xy = points[..., :2] * (radius / r.clamp_min(1e-8))[..., None]
+    c, d, e = [float(v) for v in p['linear_cde']]
+    pixels = torch.stack((c * xy[..., 0] + d * xy[..., 1], e * xy[..., 0] + xy[..., 1]), -1)
+    pixels += points.new_tensor(p['principal_point']) + 0.5
+    valid &= (theta <= float(p['max_angle'])) & (radius >= 0) & torch.isfinite(pixels).all(-1)
+    return pixels, valid
+
+
+def camera_model_rays(
+    height,
+    width,
+    intrinsics,
+    camera_model='pinhole',
+    radial_coeffs=None,
+    ftheta_parameters=None,
+    tangential_coeffs=None,
+):
+    """Unit camera rays and valid pixels. Pixel centers are (x + .5, y + .5)."""
+    y, x = torch.meshgrid(
+        torch.arange(height, device=intrinsics.device, dtype=intrinsics.dtype) + 0.5,
+        torch.arange(width, device=intrinsics.device, dtype=intrinsics.dtype) + 0.5,
+        indexing='ij',
+    )
+    pixels = torch.stack((x, y), -1)
+    valid = torch.ones((height, width), dtype=torch.bool, device=intrinsics.device)
+    if camera_model == 'pinhole':
+        distorted = (pixels - intrinsics[:2, 2]) / intrinsics.diagonal()[:2]
+        xy = distorted.clone()
+        if radial_coeffs is not None or tangential_coeffs is not None:
+            for _ in range(20):
+                _, radial, delta = _distort_pinhole(xy, radial_coeffs, tangential_coeffs)
+                xy = (distorted - delta) / radial[..., None]
+            projected, _, _ = _distort_pinhole(xy, radial_coeffs, tangential_coeffs)
+            valid &= (projected - distorted).abs().amax(-1) < 1e-5
+        rays = F.normalize(torch.cat((xy, torch.ones_like(x[..., None])), -1), dim=-1)
+        valid &= torch.isfinite(rays).all(-1)
+        return torch.nan_to_num(rays), valid
+    if camera_model == 'fisheye':
+        xy = (pixels - intrinsics[:2, 2]) / intrinsics.diagonal()[:2]
+        radius = xy.norm(dim=-1)
+        coefficients = [0.0, 1.0]
+        for k in (radial_coeffs if radial_coeffs is not None else [0.0] * 4):
+            coefficients.extend([0.0, float(k)])
+        theta, valid = _invert_camera_polynomial(coefficients, radius, radius)
+        valid &= (theta >= 0) & (theta < np.pi / 2)
+    elif camera_model == 'ftheta' and ftheta_parameters is not None:
+        p = ftheta_parameters
+        c, d, e = [float(v) for v in p['linear_cde']]
+        if abs(c - d * e) < 1e-10:
+            raise ValueError('Singular FTheta affine calibration')
+        offset = pixels - (intrinsics.new_tensor(p['principal_point']) + 0.5)
+        xy = torch.stack(
+            (offset[..., 0] - d * offset[..., 1], c * offset[..., 1] - e * offset[..., 0]), -1
+        ) / (c - d * e)
+        radius = xy.norm(dim=-1)
+        theta = _camera_polynomial(p['pixeldist_to_angle_poly'], radius)
+        if p['reference_poly'] == 'ANGLE_TO_PIXELDIST':
+            theta, valid = _invert_camera_polynomial(p['angle_to_pixeldist_poly'], radius, theta)
+        elif p['reference_poly'] != 'PIXELDIST_TO_ANGLE':
+            raise ValueError('Unknown FTheta reference polynomial')
+        valid &= (theta >= 0) & (theta <= float(p['max_angle']))
+    else:
+        raise ValueError('Expected pinhole, fisheye, or calibrated ftheta camera')
+    rays = torch.cat(
+        (xy * (torch.sin(theta) / radius.clamp_min(1e-8))[..., None], torch.cos(theta)[..., None]),
+        -1,
+    )
+    rays = torch.where((radius < 1e-8)[..., None], rays.new_tensor([0.0, 0.0, 1.0]), rays)
+    valid &= torch.isfinite(rays).all(-1)
+    return torch.nan_to_num(rays), valid
+
+
+def interpolate_camera_poses(start, end, fraction):
+    """Interpolate world-to-camera transforms as gsplat does, then return camera poses."""
+    from pytorch3d.transforms import matrix_to_quaternion, quaternion_to_matrix
+
+    start, end = torch.linalg.inv(start), torch.linalg.inv(end)
+    a, b = matrix_to_quaternion(start[:3, :3]), matrix_to_quaternion(end[:3, :3])
+    dot = (a * b).sum()
+    b = torch.where(dot < 0, -b, b)
+    dot = dot.abs().clamp(max=1.0)
+    t = torch.as_tensor(fraction, device=start.device, dtype=start.dtype)[..., None]
+    angle = torch.acos(dot.clamp(max=1 - 1e-7))
+    spherical = (torch.sin((1 - t) * angle) * a + torch.sin(t * angle) * b) / torch.sin(angle)
+    q = F.normalize(torch.where(dot > 0.9995, (1 - t) * a + t * b, spherical), dim=-1)
+    rotation = quaternion_to_matrix(q).transpose(-1, -2)
+    translation = (1 - t) * start[:3, 3] + t * end[:3, 3]
+    return rotation, -torch.einsum("...ij,...j->...i", rotation, translation)
+
+
+def camera_shutter_fraction(pixels, width, height, shutter_type):
+    if shutter_type == 'GLOBAL':
+        return torch.zeros_like(pixels[..., 0])
+    axis = 1 if shutter_type in ('ROLLING_TOP_TO_BOTTOM', 'ROLLING_BOTTOM_TO_TOP') else 0
+    if shutter_type not in (
+        'ROLLING_TOP_TO_BOTTOM',
+        'ROLLING_BOTTOM_TO_TOP',
+        'ROLLING_LEFT_TO_RIGHT',
+        'ROLLING_RIGHT_TO_LEFT',
+    ):
+        raise ValueError('Unsupported shutter type: ' + shutter_type)
+    size = (width, height)[axis]
+    if shutter_type in ('ROLLING_BOTTOM_TO_TOP', 'ROLLING_RIGHT_TO_LEFT'):
+        return (size - pixels[..., axis].ceil()) / max(size - 1, 1)
+    return pixels[..., axis].floor() / max(size - 1, 1)
+
+
+def project_world_camera(
+    points,
+    start,
+    end,
+    intrinsics,
+    width,
+    height,
+    camera_model='pinhole',
+    radial_coeffs=None,
+    ftheta_parameters=None,
+    shutter_type='GLOBAL',
+    tangential_coeffs=None,
+):
+    """Project using the same interpolated camera pose as native ray generation."""
+    fraction = points.new_full(points.shape[:-1], 0.5 if shutter_type != 'GLOBAL' else 0.0)
+    for _ in range(10 if shutter_type != 'GLOBAL' else 1):
+        rotation, origin = interpolate_camera_poses(start, end, fraction)
+        local = torch.einsum('...ji,...j->...i', rotation, points - origin)
+        pixels, valid = project_camera_model(
+            local, intrinsics, camera_model, radial_coeffs, ftheta_parameters, tangential_coeffs
+        )
+        fraction = camera_shutter_fraction(pixels, width, height, shutter_type)
+    valid &= (
+        (pixels[..., 0] >= 0)
+        & (pixels[..., 0] < width)
+        & (pixels[..., 1] >= 0)
+        & (pixels[..., 1] < height)
+    )
+    return pixels, local[..., 2], valid
